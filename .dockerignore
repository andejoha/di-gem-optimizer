# Version control
.git
.gitignore

# Frontend
frontend/node_modules
frontend/dist
# Note: frontend/test (including the golden regression corpus) is NOT
# excluded here -- `npm run build` runs `tsc -b` across all three project
# references (app, node, test), and a project with zero matched input
# files is a hard TypeScript error, not a no-op.

# IDE / editor
.idea
.vscode
*.sw?

